# Variáveis de ambiente (Vercel → Settings → Environment Variables)
#
# Front (expostas ao navegador, prefixo VITE_):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Cotação de frete da /pele-radiante (SOMENTE servidor — nunca prefixar com VITE_):
#
# Token da Melhor Envio. Gere em https://melhorenvio.com.br → Menu →
# Integrações → Tokens de acesso. Cole o token completo, sem "Bearer".
# Sem este token a calculadora responde "indisponível" e a página continua
# funcionando — mas ninguém vê preço de frete.
MELHOR_ENVIO_TOKEN=

# Opcional: use o sandbox enquanto valida a integração.
# MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br

# Subsídio de frete da AREUM, em %. IMPORTANTE: se o desconto de 30% JÁ estiver
# configurado dentro da conta da Melhor Envio, deixe 0 — senão o valor sai
# dobrado. Confirme contra um checkout real antes de publicar.
FRETE_SUBSIDIO_PERCENT=30

# Opcional: sobrescreva a origem e a embalagem. Só mexa se o peso/medidas
# mudarem na Melhor Envio. O peso de 0,2 kg vem do cadastro do SKU na Yampi.
# FRETE_CEP_ORIGEM=88306040
# FRETE_PACOTE_PESO=0.2
# FRETE_PACOTE_LARGURA=11
# FRETE_PACOTE_ALTURA=17
# FRETE_PACOTE_COMPRIMENTO=11
# FRETE_VALOR_SEGURADO=79.9
